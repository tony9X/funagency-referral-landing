# Token from @BotFather for the client bot (e.g. @funagency_bot)
BOT_TOKEN=

# Staff supergroup with Topics enabled. The bot must be an admin with "Manage topics".
# Find the id by adding @RawDataBot to the group; it starts with -100.
STAFF_CHAT_ID=

# Optional: comma-separated Telegram user ids of staff. Their messages in client
# groups are not copied back into the staff group.
STAFF_IDS=

# Shared secret the web cabinet sends as "Authorization: Bearer <API_SECRET>".
# Generate one with: openssl rand -hex 32
API_SECRET=

API_PORT=8080
DB_PATH=./data/bot.db
OTP_TTL_MIN=15
SUPPORT_NAME=FunAgency Support
